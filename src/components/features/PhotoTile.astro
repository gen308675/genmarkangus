---
import { Image } from 'astro:assets';

interface Props { class?: string; pop?: string }
const { class: className = '', pop = '3.5rem' } = Astro.props;

const photo = Object.values(
  import.meta.glob<ImageMetadata>('../../assets/profile-cutout.{png,webp}', { eager: true, import: 'default' })
)[0];
---
<div class:list={['relative rounded-2xl border border-white/10 bg-stone-200', className]} style={`--pop:${pop}`}>
  {photo ? (
    <Image src={photo} alt="Gen Mark D. Angus" loading="eager"
      class="pointer-events-none absolute bottom-0 left-0 z-10 h-[calc(100%+var(--pop))] w-full rounded-b-2xl object-cover object-top" />
  ) : (
    <div class="flex h-full items-center justify-center text-5xl font-semibold text-stone-500">GA</div>
  )}
</div>
---
import { Icon } from 'astro-icon/components';
import GlassCard from '../ui/GlassCard.astro';
import StatusBadge from '../ui/StatusBadge.astro';

interface Props { class?: string }
const { class: className = '' } = Astro.props;

const siteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY ?? '';
const booking = import.meta.env.PUBLIC_BOOKING_URL ?? '';
const dialogPrompts = ['What has Gen built?', 'Does Gen know security?', 'Is Gen available?', 'What would Gen build for my business?'];
const chip = 'rounded-full border border-emerald-300/30 px-3 py-1 text-left text-xs text-emerald-200 transition hover:bg-emerald-300/10';
const iconBtn = 'grid h-10 w-10 shrink-0 place-items-center rounded-xl border border-white/10 text-gray-300 transition hover:bg-white/10';
---
<GlassCard class:list={['flex flex-col justify-between', className]}>
  <div>
    <StatusBadge status="online" label="Live 24/7" />
    <h2 class="mt-3 text-lg font-semibold text-white">Ask my AI about me</h2>
    <p class="mt-1 text-sm text-gray-300">A RAG agent trained on my experience. Type or talk to it.</p>
  </div>
    <div class="mt-4">
    <button type="button" data-chat-open data-umami-event="chat_open"
      class="flex w-full items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-emerald-300 to-teal-200 px-4 py-2.5 text-sm font-semibold text-black transition hover:opacity-90">
      <Icon name="lucide:mic" class="h-4 w-4" /> Chat or talk to my AI
    </button>
  </div>
</GlassCard>

<dialog data-chat-dialog data-sitekey={siteKey} data-booking={booking} aria-labelledby="chat-title"
  class="m-auto h-[min(80vh,42rem)] w-[min(92vw,40rem)] overflow-hidden rounded-2xl border border-white/10 bg-[#0b0f17] p-0 text-gray-200 shadow-2xl backdrop:bg-black/70 backdrop:backdrop-blur-sm open:flex max-sm:h-dvh max-sm:max-h-none max-sm:w-screen max-sm:max-w-none max-sm:rounded-none">
  <div class="flex min-h-0 w-full flex-col">
    <header class="flex items-center justify-between border-b border-white/10 px-5 py-4">
      <div>
        <h2 id="chat-title" class="text-base font-semibold text-white">Neural Mirror</h2>
        <p class="text-xs text-gray-400">AI assistant for Gen's portfolio</p>
      </div>
      <div class="flex gap-2">
        <button type="button" data-chat-sound aria-pressed="true" aria-label="Read replies aloud: on"
          class="h-8 w-8 rounded-full border border-white/10 text-sm text-gray-300 hover:bg-white/10">🔊</button>
        <button type="button" data-chat-close aria-label="Close chat"
          class="h-8 w-8 rounded-full border border-white/10 text-gray-300 hover:bg-white/10">✕</button>
      </div>
    </header>

    <div data-chat-log aria-live="polite" class="flex-1 space-y-3 overflow-y-auto px-5 py-4"></div>

    <div class="px-5 pb-2">
      <div data-chat-chips class="flex flex-wrap gap-2">
        {dialogPrompts.map((p) => <button type="button" data-chat-prompt={p} class={chip}>{p}</button>)}
      </div>
      <div data-turnstile class="mt-2"></div>
    </div>

    <form data-chat-form class="flex gap-2 border-t border-white/10 px-5 py-3">
      <button type="button" data-chat-mic aria-label="Record a voice question"
        class={`${iconBtn} data-[rec=true]:animate-pulse data-[rec=true]:border-red-400 data-[rec=true]:bg-red-500/20 data-[rec=true]:text-red-300`}>
        <Icon name="lucide:mic" class="h-5 w-5" />
      </button>
      <input data-chat-input type="text" maxlength="500" autocomplete="off" aria-label="Your message"
        placeholder="Ask about Gen's projects, skills or availability"
        class="min-w-0 flex-1 rounded-xl border border-white/10 bg-white/5 px-4 py-2.5 text-sm text-white placeholder:text-gray-500 focus:border-emerald-300/60 focus:outline-none" />
      <button type="submit" class="rounded-xl bg-emerald-300 px-4 py-2.5 text-sm font-semibold text-black disabled:opacity-50">Send</button>
    </form>
    <p class="px-5 pb-3 text-[11px] text-gray-500">
      Answers are generated by AI from Gen's portfolio knowledge base. Voice clips are transcribed by a third-party AI service. Please don't share sensitive information.
    </p>
  </div>
</dialog>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('[data-chat-dialog]')!;
  const log = dialog.querySelector<HTMLElement>('[data-chat-log]')!;
  const form = dialog.querySelector<HTMLFormElement>('[data-chat-form]')!;
  const input = dialog.querySelector<HTMLInputElement>('[data-chat-input]')!;
  const sendBtn = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
  const micBtn = dialog.querySelector<HTMLButtonElement>('[data-chat-mic]')!;
  const soundBtn = dialog.querySelector<HTMLButtonElement>('[data-chat-sound]')!;
  const chips = dialog.querySelector<HTMLElement>('[data-chat-chips]')!;
  const box = dialog.querySelector<HTMLElement>('[data-turnstile]')!;
  const siteKey = dialog.dataset.sitekey ?? '';
  const booking = dialog.dataset.booking ?? '';
  const FALLBACK = `Sorry, my AI is busy or offline right now.${booking ? ` You can book a call with Gen here: ${booking}` : ''}`;
  const URL_RE = /(https?:\/\/[^\s<>()]+[^\s<>().,!?;:])/g;
  const MAX_SEC = 15;
  const PLACEHOLDER = input.placeholder;

  let busy = false;
  let greeted = false;
  let speakOn = true;
  let token = '';
  let widgetId: string | undefined;
  let loader: Promise<void> | undefined;
  let widgetReady: Promise<void> | undefined;

  // ---------- rendering (text only, never innerHTML) ----------
  function fill(el: HTMLElement, text: string) {
    el.textContent = '';
    text.split(URL_RE).forEach((part, i) => {
      if (i % 2 === 1) {
        const a = document.createElement('a');
        a.href = part; a.textContent = part; a.target = '_blank'; a.rel = 'noopener noreferrer'; a.className = 'underline';
        el.appendChild(a);
      } else {
        el.appendChild(document.createTextNode(part));
      }
    });
  }

  function addMessage(role: 'user' | 'assistant', text: string): HTMLElement {
    const row = document.createElement('div');
    row.className = role === 'user' ? 'flex justify-end' : 'flex justify-start';
    const bubble = document.createElement('div');
    bubble.className = 'max-w-[85%] whitespace-pre-wrap break-words rounded-2xl px-4 py-2 text-sm leading-relaxed ' +
      (role === 'user' ? 'bg-emerald-300 text-black' : 'border border-white/10 bg-white/5 text-gray-100');
    fill(bubble, text);
    row.appendChild(bubble);
    log.appendChild(row);
    log.scrollTop = log.scrollHeight;
    return bubble;
  }

  function setBusy(value: boolean) {
    busy = value;
    input.disabled = sendBtn.disabled = micBtn.disabled = value;
    if (!value) input.focus();
  }

  // ---------- speech out (browser built-in, free) ----------
  function speak(text: string) {
    if (!speakOn || !('speechSynthesis' in window)) return;
    window.speechSynthesis.cancel();
    const u = new SpeechSynthesisUtterance(text.replace(/https?:\/\/\S+/g, 'the link on screen'));
    u.rate = 1.02;
    window.speechSynthesis.speak(u);
  }

  soundBtn.addEventListener('click', () => {
    speakOn = !speakOn;
    soundBtn.textContent = speakOn ? '🔊' : '🔇';
    soundBtn.setAttribute('aria-pressed', String(speakOn));
    soundBtn.setAttribute('aria-label', `Read replies aloud: ${speakOn ? 'on' : 'off'}`);
    if (!speakOn) window.speechSynthesis?.cancel();
  });

  // ---------- Turnstile ----------
  function loadTurnstile(): Promise<void> {
    if ((window as any).turnstile) return Promise.resolve();
    loader ??= new Promise<void>((resolve, reject) => {
      const s = document.createElement('script');
      s.src = 'https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit';
      s.async = true;
      s.onload = () => resolve();
      s.onerror = () => reject(new Error('turnstile failed to load'));
      document.head.appendChild(s);
    });
    return loader;
  }

  function ensureWidget(): Promise<void> {
    if (!siteKey) return Promise.resolve();
    widgetReady ??= (async () => {
      await loadTurnstile();
      widgetId = (window as any).turnstile.render(box, {
        sitekey: siteKey,
        appearance: 'interaction-only',
        callback: (t: string) => { token = t; },
        'expired-callback': () => { token = ''; },
        'error-callback': () => { token = ''; },
      });
    })();
    return widgetReady;
  }

  async function waitForToken(ms: number): Promise<boolean> {
    const end = Date.now() + ms;
    while (!token && Date.now() < end) await new Promise((r) => setTimeout(r, 200));
    return !!token;
  }

  // Runs a request; if the server asks for a challenge, gets a fresh token and retries once.
  async function withChallenge(run: () => Promise<Response>): Promise<Response> {
    const res = await run();
    if (res.status === 401 && siteKey) {
      await ensureWidget();
      if (token) { token = ''; (window as any).turnstile.reset(widgetId); }
      if (await waitForToken(10000)) return run();
    }
    return res;
  }

  // ---------- text chat ----------
  const postChat = (message: string) =>
    withChallenge(() =>
      fetch('/api/chat', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ message, turnstileToken: token || undefined }),
      })
    );

  async function send(text: string) {
    const message = text.trim();
    if (!message || busy) return;
    setBusy(true);
    input.value = '';
    chips.classList.add('hidden');
    addMessage('user', message);
    const pending = addMessage('assistant', 'Thinking…');
    pending.classList.add('animate-pulse');
    try {
      const res = await postChat(message);
      const data = (await res.json().catch(() => ({}))) as { reply?: unknown };
      if (res.ok && typeof data.reply === 'string') fill(pending, data.reply);
      else if (res.status === 429) fill(pending, 'You are sending messages quickly. Please wait a moment and try again.');
      else fill(pending, FALLBACK);
      (window as any).umami?.track?.('chat_message');
    } catch {
      fill(pending, FALLBACK);
    } finally {
      pending.classList.remove('animate-pulse');
      setBusy(false);
    }
  }

  // ---------- voice chat ----------
  let recorder: MediaRecorder | null = null;
  let chunks: Blob[] = [];
  let tick: number | undefined;
  let stopTimer: number | undefined;

  const pickMime = () =>
    ['audio/webm;codecs=opus', 'audio/webm', 'audio/mp4', 'audio/ogg;codecs=opus'].find((t) =>
      (window as any).MediaRecorder?.isTypeSupported?.(t)
    ) ?? '';

  function recordingUi(on: boolean, seconds = 0) {
    micBtn.dataset.rec = String(on);
    micBtn.setAttribute('aria-label', on ? 'Stop recording and send' : 'Record a voice question');
    input.disabled = on;
    input.placeholder = on ? `Recording ${seconds}s. Tap the mic to send` : PLACEHOLDER;
  }

  async function startRecording() {
    if (busy || recorder) return;
    if (!navigator.mediaDevices?.getUserMedia || !(window as any).MediaRecorder) {
      addMessage('assistant', 'Voice is not supported in this browser. Please use the text chat.');
      return;
    }
    // Unlock speech playback on iOS while we still have a user gesture.
    window.speechSynthesis?.cancel();
    window.speechSynthesis?.speak(new SpeechSynthesisUtterance(''));
    ensureWidget().catch(() => {});

    try {
      const stream = await navigator.mediaDevices.getUserMedia({ audio: true });
      const mime = pickMime();
      const rec = new MediaRecorder(stream, mime ? { mimeType: mime } : undefined);
      recorder = rec;
      chunks = [];
      rec.ondataavailable = (ev) => { if (ev.data.size) chunks.push(ev.data); };
      rec.onstop = () => {
        stream.getTracks().forEach((t) => t.stop());
        clearInterval(tick); clearTimeout(stopTimer);
        const type = (rec.mimeType || mime || 'audio/webm').split(';')[0];
        const blob = new Blob(chunks, { type });
        recorder = null;
        recordingUi(false);
        if (blob.size > 1000) void sendVoice(blob);
      };
      rec.start();
      const startedAt = Date.now();
      recordingUi(true, 0);
      tick = window.setInterval(() => recordingUi(true, Math.floor((Date.now() - startedAt) / 1000)), 500);
      stopTimer = window.setTimeout(stopRecording, MAX_SEC * 1000);
    } catch {
      addMessage('assistant', 'I could not access the microphone. Please allow microphone access, or use the text chat.');
    }
  }

  function stopRecording() {
    if (recorder && recorder.state !== 'inactive') recorder.stop();
  }

  const postVoice = (blob: Blob) =>
    withChallenge(() => {
      const fd = new FormData();
      fd.append('audio', blob, `voice.${blob.type.split('/')[1] || 'webm'}`);
      if (token) fd.append('turnstileToken', token);
      return fetch('/api/voice', { method: 'POST', body: fd });
    });

  async function sendVoice(blob: Blob) {
    if (busy) return;
    setBusy(true);
    chips.classList.add('hidden');
    const mine = addMessage('user', '🎙 Transcribing…');
    mine.classList.add('animate-pulse');
    const pending = addMessage('assistant', 'Thinking…');
    pending.classList.add('animate-pulse');
    try {
      const res = await postVoice(blob);
      const data = (await res.json().catch(() => ({}))) as { transcript?: unknown; reply?: unknown; error?: unknown };
      mine.classList.remove('animate-pulse');
      if (res.ok && typeof data.reply === 'string' && typeof data.transcript === 'string') {
        fill(mine, `🎙 ${data.transcript}`);
        fill(pending, data.reply);
        speak(data.reply);
        (window as any).umami?.track?.('voice_message');
      } else if (data.error === 'no_speech') {
        fill(mine, '🎙 (nothing heard)');
        fill(pending, "I didn't catch that. Please try again, a little closer to the microphone.");
      } else if (res.status === 429) {
        fill(mine, '🎙 …');
        fill(pending, 'You are sending messages quickly. Please wait a moment and try again.');
      } else {
        fill(mine, '🎙 …');
        fill(pending, `Voice is unavailable right now. You can still type your question. ${booking ? `Or book a call: ${booking}` : ''}`);
      }
    } catch {
      mine.classList.remove('animate-pulse');
      fill(mine, '🎙 …');
      fill(pending, FALLBACK);
    } finally {
      pending.classList.remove('animate-pulse');
      setBusy(false);
    }
  }

  micBtn.addEventListener('click', () => (recorder ? stopRecording() : void startRecording()));

  // ---------- open / close ----------
  function openChat(opts: { prompt?: string; voice?: boolean } = {}) {
    if (!dialog.open) dialog.showModal();
    document.body.style.overflow = 'hidden';
    if (!greeted) {
      greeted = true;
      addMessage(
        'assistant',
        opts.voice
          ? "Hi! Tap the microphone, ask your question (up to 15 seconds), then tap it again to send. I'll answer out loud and in text."
          : "Hi! I'm the assistant for Gen's portfolio. Ask me about his projects, skills, experience or availability. You can also tap the microphone to talk."
      );
    }
    ensureWidget().catch(() => {});
    if (opts.prompt) void send(opts.prompt);
    else if (opts.voice) micBtn.focus();
    else input.focus();
  }

  function closeChat() {
    stopRecording();
    window.speechSynthesis?.cancel();
    dialog.close();
  }

  document.querySelectorAll('[data-chat-open]').forEach((b) => b.addEventListener('click', () => openChat()));
  document.querySelectorAll<HTMLElement>('[data-chat-prompt]').forEach((b) =>
    b.addEventListener('click', () => openChat({ prompt: b.dataset.chatPrompt }))
  );
  dialog.querySelector('[data-chat-close]')?.addEventListener('click', closeChat);
  dialog.addEventListener('click', (e) => { if (e.target === dialog) closeChat(); });
  dialog.addEventListener('close', () => { document.body.style.overflow = ''; });
  form.addEventListener('submit', (e) => { e.preventDefault(); void send(input.value); });
</script>
---
import { Icon } from 'astro-icon/components';
import GlassCard from '../ui/GlassCard.astro';
import StatusBadge from '../ui/StatusBadge.astro';
import { projects } from '../../data/projects';

interface Props { class?: string }
const { class: className = '' } = Astro.props;

const thumb = (id: string) => `https://i.ytimg.com/vi/${id}/hqdefault.jpg`;
const roundBtn = 'grid h-8 w-8 place-items-center rounded-full border border-white/10 text-gray-300 transition hover:bg-white/10';
const pill = 'rounded-full border border-white/10 px-3 py-1 text-xs text-gray-300';
---
<GlassCard class:list={['overflow-hidden', className]}>
  <section data-carousel data-paused="false" aria-roledescription="carousel" aria-label="Projects"
    class="group flex h-full min-h-96 flex-col">
    <div class="mb-4 flex items-center justify-between">
      <p class="text-sm text-gray-400">Projects</p>
      <button type="button" data-projects-open aria-label="Expand projects and watch walkthroughs" class={roundBtn}>
        <Icon name="lucide:maximize-2" class="h-4 w-4" />
      </button>
    </div>

    <div data-track tabindex="0"
      class="flex flex-1 snap-x snap-mandatory overflow-x-auto [scrollbar-width:none] [&::-webkit-scrollbar]:hidden">
      {projects.map((p, i) => (
        <article role="group" aria-roledescription="slide" aria-label={`${i + 1} of ${projects.length}`}
          data-slug={p.slug} class="flex min-w-full snap-center flex-col justify-between gap-4">
          <div>
            <StatusBadge status={p.status === 'live' ? 'online' : 'checking'}
              label={p.status === 'live' ? 'Live' : 'Coming soon'} />
            <p class="mt-6 text-6xl font-light text-emerald-300/80">{String(i + 1).padStart(2, '0')}</p>
            <h3 class="mt-2 text-xl font-semibold text-white">{p.title}</h3>
            <p class="mt-2 text-sm text-gray-300">{p.tagline}</p>
          </div>
          <div>
            <ul class="mb-4 flex flex-wrap gap-2">
              {p.tags.map((t) => <li class={pill}>{t}</li>)}
            </ul>
            <button type="button" data-projects-open={p.slug} data-umami-event="walkthrough_open"
              class="flex w-full items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-emerald-300 to-teal-200 px-4 py-2.5 text-sm font-semibold text-black transition hover:opacity-90">
              <Icon name="lucide:play" class="h-4 w-4" /> Watch walkthrough
            </button>
          </div>
        </article>
      ))}
    </div>

    <div class="mt-5 flex justify-center gap-3">
      {projects.map((p, i) => (
        <button type="button" data-dot={i} data-title={p.title} aria-label={`Go to ${p.title}`}
          class="relative h-2 w-2 rounded-full bg-white/20 transition-all before:absolute before:-inset-2 before:content-[''] aria-[current=true]:w-6 aria-[current=true]:bg-emerald-300 group-data-[paused=true]:aria-[current=true]:bg-white"></button>
      ))}
    </div>
  </section>
</GlassCard>

<dialog data-projects-dialog aria-labelledby="projects-title"
  class="m-auto h-[min(88vh,50rem)] w-[min(94vw,60rem)] overflow-hidden rounded-2xl border border-white/10 bg-[#0b0f17] p-0 text-gray-200 shadow-2xl backdrop:bg-black/70 backdrop:backdrop-blur-sm open:flex max-sm:h-dvh max-sm:max-h-none max-sm:w-screen max-sm:max-w-none max-sm:rounded-none">
  <div class="flex min-h-0 w-full flex-col">
    <header class="flex items-center justify-between border-b border-white/10 px-5 py-4">
      <div>
        <h2 id="projects-title" class="text-base font-semibold text-white">Project walkthroughs</h2>
        <p class="text-xs text-gray-400">Short recorded tours of how each workflow is built</p>
      </div>
      <button type="button" data-projects-close aria-label="Close walkthroughs" class={roundBtn}>✕</button>
    </header>

    <div data-projects-list class="flex-1 space-y-5 overflow-y-auto px-5 py-5">
      {projects.map((p) => (
        <article id={`p-${p.slug}`} data-slug={p.slug}
          class="grid gap-5 rounded-2xl border border-white/10 bg-white/[0.03] p-4 md:grid-cols-2">
          <div data-video-box class="relative aspect-video overflow-hidden rounded-xl border border-white/10 bg-black">
            {p.videoId ? (
              <button type="button" data-video-play data-video-id={p.videoId} data-title={p.title}
                aria-label={`Play walkthrough: ${p.title}`} class="group/play absolute inset-0 h-full w-full">
                <img src={thumb(p.videoId)} alt="" loading="lazy"
                  class="h-full w-full object-cover opacity-80 transition group-hover/play:opacity-100" />
                <span class="absolute inset-0 grid place-items-center">
                  <span class="grid h-16 w-16 place-items-center rounded-full bg-emerald-300 text-black shadow-lg transition group-hover/play:scale-105">
                    <Icon name="lucide:play" class="ml-1 h-7 w-7" />
                  </span>
                </span>
              </button>
            ) : (
              <div class="grid h-full place-items-center p-4 text-center text-sm text-gray-400">
                Walkthrough video coming soon
              </div>
            )}
          </div>

          <div class="flex flex-col">
            <div>
              <StatusBadge status={p.status === 'live' ? 'online' : 'checking'}
                label={p.status === 'live' ? 'Live' : 'Coming soon'} />
            </div>
            <h3 class="mt-3 text-lg font-semibold text-white">{p.title}</h3>
            <p class="mt-1 text-sm text-gray-300">{p.tagline}</p>
            <ul class="mt-3 space-y-1.5 text-sm text-gray-300">
              {p.points.map((pt) => (
                <li class="flex gap-2"><span class="text-emerald-300">•</span><span>{pt}</span></li>
              ))}
            </ul>
            <ul class="mt-3 flex flex-wrap gap-2">
              {p.tags.map((t) => <li class={pill}>{t}</li>)}
            </ul>
            <div class="mt-auto flex flex-wrap gap-3 pt-4">
              {p.caseHref && <a href={p.caseHref} class="text-sm text-emerald-300 underline">Read the case study</a>}
              {p.repoHref && <a href={p.repoHref} target="_blank" rel="noopener noreferrer" class="text-sm text-emerald-300 underline">Workflow on GitHub</a>}
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</dialog>

<script>
  // ---------- walkthrough dialog ----------
  const dialog = document.querySelector<HTMLDialogElement>('[data-projects-dialog]')!;
  const list = dialog.querySelector<HTMLElement>('[data-projects-list]')!;
  let dialogOpen = false;

  const announce = () => document.dispatchEvent(new CustomEvent('projects-dialog'));

  function resetVideos(except?: Element) {
    dialog.querySelectorAll<HTMLElement>('[data-video-box]').forEach((box) => {
      if (box === except) return;
      box.querySelector('iframe')?.remove();
      const btn = box.querySelector<HTMLButtonElement>('[data-video-play]');
      if (btn) btn.hidden = false;
    });
  }

  dialog.querySelectorAll<HTMLButtonElement>('[data-video-play]').forEach((btn) =>
    btn.addEventListener('click', () => {
      const box = btn.closest('[data-video-box]')!;
      resetVideos(box);
      const iframe = document.createElement('iframe');
      iframe.src = `https://www.youtube-nocookie.com/embed/${encodeURIComponent(btn.dataset.videoId ?? '')}?autoplay=1&rel=0&modestbranding=1&playsinline=1`;
      iframe.title = btn.dataset.title ?? 'Walkthrough video';
      iframe.allow = 'autoplay; encrypted-media; picture-in-picture; fullscreen';
      iframe.allowFullscreen = true;
      iframe.className = 'absolute inset-0 h-full w-full';
      box.appendChild(iframe);
      btn.hidden = true;
      (window as any).umami?.track?.('video_play', { project: btn.closest<HTMLElement>('[data-slug]')?.dataset.slug });
    })
  );

  function openProjects(slug?: string) {
    if (!dialog.open) dialog.showModal();
    document.body.style.overflow = 'hidden';
    dialogOpen = true;
    announce();
    const target = slug ? list.querySelector(`#p-${CSS.escape(slug)}`) : null;
    if (target) target.scrollIntoView({ block: 'start' });
    else list.scrollTop = 0;
  }

  dialog.querySelector('[data-projects-close]')?.addEventListener('click', () => dialog.close());
  dialog.addEventListener('click', (e) => { if (e.target === dialog) dialog.close(); });
  dialog.addEventListener('close', () => {
    resetVideos();
    document.body.style.overflow = '';
    dialogOpen = false;
    announce();
  });

  // ---------- carousel ----------
  document.querySelectorAll<HTMLElement>('[data-carousel]').forEach((root) => {
    const track = root.querySelector<HTMLElement>('[data-track]')!;
    const slides = Array.from(track.children) as HTMLElement[];
    const dots = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-dot]'));
    const count = slides.length;
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    let timer: number | undefined;
    let paused = reduce; // reduced-motion visitors start paused

    const current = () => Math.round(track.scrollLeft / track.clientWidth);
    const go = (i: number) =>
      track.scrollTo({
        left: Math.max(0, Math.min(count - 1, i)) * track.clientWidth,
        behavior: reduce ? 'auto' : 'smooth',
      });

    const update = () =>
      dots.forEach((d, i) => {
        const active = i === current();
        d.setAttribute('aria-current', String(active));
        d.setAttribute(
          'aria-label',
          active && paused ? `${d.dataset.title}, autoplay paused. Select again to resume` : `Go to ${d.dataset.title}`
        );
      });

    const restart = () => {
      if (timer) { clearInterval(timer); timer = undefined; }
      track.setAttribute('aria-live', paused ? 'polite' : 'off');
      if (!paused && !document.hidden && !dialogOpen) {
        timer = window.setInterval(() => go((current() + 1) % count), 5000);
      }
    };

    const setPaused = (value: boolean) => {
      paused = value;
      root.dataset.paused = String(value);
      restart();
      update();
    };

    dots.forEach((d, i) =>
      d.addEventListener('click', () => {
        if (paused && i === current()) setPaused(false);
        else { go(i); setPaused(true); }
      })
    );

    root.querySelectorAll<HTMLButtonElement>('[data-projects-open]').forEach((b) =>
      b.addEventListener('click', () => openProjects(b.dataset.projectsOpen || slides[current()]?.dataset.slug))
    );

    track.addEventListener('scroll', () => requestAnimationFrame(update), { passive: true });
    track.addEventListener('pointerdown', restart);
    track.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') go(current() + 1);
      if (e.key === 'ArrowLeft') go(current() - 1);
    });
    document.addEventListener('visibilitychange', restart);
    document.addEventListener('projects-dialog', restart);

    root.dataset.paused = String(paused);
    update();
    restart();
  });
</script>
---
import { Icon } from 'astro-icon/components';
import GlassCard from '../ui/GlassCard.astro';
import { contacts } from '../../data/contacts';

interface Props { class?: string }
const { class: className = '' } = Astro.props;
---
<GlassCard class:list={['flex items-center justify-center', className]}>
  <nav aria-label="Contact links" class="flex flex-row items-center gap-6 lg:flex-col lg:gap-7">
    {contacts.map((c) => (
      <a href={c.href}
        target={(c.href ?? '').startsWith('http') ? '_blank' : undefined}
        rel="noopener noreferrer"
        aria-label={c.label} title={c.label} data-umami-event={`contact_${c.id}`}
        class="text-emerald-300 transition hover:scale-110 hover:text-white">
        <Icon name={c.icon} class="h-7 w-7" />
      </a>
    ))}
  </nav>
</GlassCard>
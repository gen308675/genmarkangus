---
interface Props { status?: 'online' | 'offline' | 'checking'; label?: string }
const { status = 'checking', label } = Astro.props;
const colors = {
  online: 'bg-emerald-400 shadow-emerald-400/60',
  offline: 'bg-red-500 shadow-red-500/60',
  checking: 'bg-amber-400 shadow-amber-400/60',
};
const text = label ?? { online: 'System online', offline: 'System offline', checking: 'Checking…' }[status];
---
<span id="data-status-badge" data-status={status}
  class="inline-flex items-center gap-2 rounded-full border border-white/10 bg-white/5 px-3 py-1 text-xs text-gray-300">
  <span class:list={["h-2 w-2 rounded-full shadow-[0_0_8px]", colors[status]]}></span>
  {text}
</span>